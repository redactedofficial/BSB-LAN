              "name": "Check top-up now",
              "icon": "mdi:water-check",
              "entity": "script.bsb_dhw_topup_check",
              "show_state": false,
              "tap_action": {
                "action": "perform-action",
                "perform_action": "script.bsb_dhw_topup_check"
