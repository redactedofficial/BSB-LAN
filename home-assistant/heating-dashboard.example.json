        {
          "type": "grid",
          "cards": [
            {
              "type": "heading",
              "heading": "Room heating · Calendar",
              "icon": "mdi:calendar-clock"
            },
            {
              "type": "entities",
              "show_header_toggle": false,
              "entities": [
